PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# Public URL of this server (agents call it). Keep localhost unless you tunnel.
PUBLIC_BASE_URL=http://localhost:4000

# x402 facilitator (PayAI: Solana devnet, sponsors SOL fees; x402.org is rate-limited)
FACILITATOR_URL=https://facilitator.payai.network
# Seller wallet that receives USDC. `bun run setup` fills this in.
PAY_TO_ADDRESS=

# QuickNode endpoints (strongly recommended; public RPCs rate-limit hard)
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# Secret QuickNode Streams sends as the `x-qn-token` header
QUICKNODE_STREAM_TOKEN=

# Optional: LLM narratives (falls back to a template)
ANTHROPIC_API_KEY=

# Optional: a real wallet used as a demo agent (pays on devnet; trace shows its mainnet history).
# base58 secret key or JSON byte array. NEVER commit .env.
DEMO_HERO_SECRET_KEY=
